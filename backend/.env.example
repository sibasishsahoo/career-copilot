# Copy this file to ".env" (same folder) and fill in your real values:
#   cp .env.example .env          (macOS/Linux)
#   copy .env.example .env        (Windows cmd)
# The real ".env" file is git-ignored. NEVER commit it.

# Which provider to use: gemini | anthropic | openai
LLM_PROVIDER=gemini

# --- Gemini (default, has a free tier) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model names change over time. If you get a "model not found" error, run:
#   python -m scripts.list_gemini_models
# and put one of the printed names (without the "models/" prefix) here.
GEMINI_MODEL=gemini-2.5-flash-lite

# --- Anthropic (optional, for later) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- OpenAI (optional, for later) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Database (Phase 4) ---
# Optional. If you leave this commented out, data is stored in backend/career_copilot.db
# DATABASE_URL=sqlite:///./my_other_database.db

# --- Knowledge base / RAG (Phase 6) ---
# All optional. Defaults: notes saved in Chroma at backend/chroma_data, embedded by a local model.
# RAG_EMBEDDER=local        # "local" downloads a ~80 MB model on first use; "hashing" needs no download
#                           # but only matches identical words (good for offline demos and tests)
# RAG_STORE=chroma          # "memory" keeps notes only until the server stops
# CHROMA_PATH=
# RAG_CHUNK_SIZE=800
# RAG_CHUNK_OVERLAP=150
# RAG_MIN_SCORE=            # leave unset to use the embedder's own default (local 0.25, hashing 0.05)

# --- Agent (Phase 7) ---
# AGENT_MAX_STEPS=4         # each step is one LLM call; on the Gemini free tier keep this small

# --- Interview preparation (Phase 9) ---
# INTERVIEW_QUESTION_COUNT=8   # questions per pack (3 to 12). Each pack costs 2 LLM calls, whatever the count.
